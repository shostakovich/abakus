<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <.theme_meta />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Abakus" suffix=" · Abakus">
      {assigns[:page_title]}
    </.live_title>
    <.theme_script nonce={assigns[:csp_nonce]} />
    <script nonce={assigns[:csp_nonce]}>
      try { if (localStorage.getItem("abakus:register-memo") === "hidden") document.documentElement.setAttribute("data-register-memo", "hidden") } catch (_) {}
    </script>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href={~p"/images/icon.svg"} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/setzkasten/fonts/Figtree-Variable.woff2"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-base-100 text-base-content">
    {@inner_content}
  </body>
</html>
